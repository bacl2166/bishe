{
  "output": "runs/musical-experiment1-expanded",
  "metadata": "data/meta_Musical_Instruments.jsonl",
  "reviews": "data/Musical_Instruments.jsonl",
  "train_before": "2021-01-01",
  "test_from": "2022-01-01",
  "max_items": 10000,
  "min_item_interactions": 5,
  "min_history": 5,
  "max_history": 50,
  "max_users": 2000,
  "evaluation_split": "test",
  "max_requests": 20000,
  "request_seed": 2026,
  "constraint_families": [
    "no_filter",
    "price",
    "brand",
    "category",
    "rating",
    "spec",
    "price_brand",
    "price_brand_spec",
    "random_matched"
  ],
  "constraints": {
    "rating_min_count": 5
  },
  "scorers": [
    "most_popular",
    "item_knn",
    "sasrec"
  ],
  "scorer_seeds": [
    11,
    22,
    33
  ],
  "encoding_seeds": [
    11,
    22,
    33
  ],
  "encodings": [
    "semantic_hierarchical",
    "collaborative_hierarchical",
    "rqvae",
    "rqkmeans",
    "opq",
    "letter",
    "cost",
    "seater",
    "topotok",
    "bonsai",
    "random_balanced",
    "attribute_first"
  ],
  "embeddings": {
    "backend": "sentence_transformer",
    "model": "sentence-transformers/all-MiniLM-L6-v2",
    "device": "cpu",
    "batch_size": 64
  },
  "collaborative_dim": 64,
  "scorer": {
    "device": "cuda",
    "epochs": 30,
    "batch_size": 128,
    "d_model": 64,
    "heads": 2,
    "layers": 2,
    "lr": 0.001,
    "patience": 3,
    "max_train_samples": 50000
  },
  "tokenizer": {
    "device": "cuda",
    "epochs": 100,
    "batch_size": 256,
    "branching": 16,
    "depth": 3,
    "codebook_size": 64
  },
  "tokenizer_overrides": {
    "attribute_first": {
      "attributes": [
        "price",
        "brand",
        "category"
      ]
    }
  },
  "modes": [
    "preserve",
    "local",
    "feasible_mass"
  ],
  "temperature": 1.0,
  "top_k": 10,
  "budgets": [
    {
      "beam": 10
    },
    {
      "beam": 30
    },
    {
      "beam": 100
    },
    {
      "beam": 100,
      "nodes": 500
    },
    {
      "beam": 100,
      "nodes": 2000
    },
    {
      "beam": 100,
      "nodes": 10000
    }
  ],
  "bootstrap_samples": 1000
}
